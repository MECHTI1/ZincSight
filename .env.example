# Optional overrides for ZincSight settings. Copy to .env (or set environment
# variables) to change them; the values below are the built-in defaults.
DEBUGGING_TEMP=false
KEEP_TEMP_TABLES_TEMP=false

# Drop predicted sites with probability below the threshold after compression.
FILTER_PROB_AFTER_COMPRESSION=true
EXCLUDE_PREDICTIONS_WITH_PROB_THRESHOLD=0.0001
